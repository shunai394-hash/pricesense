# Copy to .env.local for development. Never commit real secrets.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (browser + Auth)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth (configured in Google Cloud + Supabase Auth provider)
# Do not prefix with NEXT_PUBLIC_. Next.js does not embed these in the client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Admin APIs (Bearer or x-admin-token)
ADMIN_TOKEN=

# Vercel Cron for AI new-business discovery (optional). Unset = cron fails closed unless ADMIN_TOKEN is sent.
CRON_SECRET=

# OpenAI-compatible AI (server only)
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Optional prospecting / outreach providers.
# Unset = 未接続. Do not invent connected data.
APOLLO_API_KEY=
CLAY_API_KEY=
INSTANTLY_API_KEY=
SALES_MARKER_API_KEY=
SANSAN_API_KEY=

# Shared research / correspondent feeds use public RSS only unless extra keys are set.

# Stripe (keep existing production values)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Optional
RESEND_API_KEY=
RESEND_FROM_EMAIL=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
